#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <LoRa.h>

// Your existing LoRa wiring
#define SS   15    // D8
#define RST  16    // D0
#define DIO0 5     // D1

ESP8266WebServer server(80);

const char* ssid = "pro";
const char* password = "12341234";

void sendCommand(String command)
{
  Serial.print("Sending: ");
  Serial.println(command);

  LoRa.beginPacket();
  LoRa.print(command);
  LoRa.endPacket();

  Serial.println("Command sent");
}

void handleRoot()
{
  String page = R"rawliteral(
<!DOCTYPE html>
<html>

<head>
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>LoRa LED Control</title>

<style>

body {
  font-family: Arial;
  text-align: center;
  margin-top: 60px;
}

button {
  width: 220px;
  height: 70px;
  font-size: 25px;
  margin: 15px;
  border-radius: 15px;
}

</style>

</head>

<body>

<h1>LoRa LED Control</h1>

<form action="/on">
<button>LED ON</button>
</form>

<form action="/off">
<button>LED OFF</button>
</form>

</body>

</html>
)rawliteral";

  server.send(200, "text/html", page);
}

void handleON()
{
  sendCommand("LED_ON");

  server.send(
    200,
    "text/html",
    "<h1>LED ON Command Sent</h1>"
    "<br><a href='/'>Back</a>"
  );
}

void handleOFF()
{
  sendCommand("LED_OFF");

  server.send(
    200,
    "text/html",
    "<h1>LED OFF Command Sent</h1>"
    "<br><a href='/'>Back</a>"
  );
}

void setup()
{
  Serial.begin(9600);

  Serial.println();
  Serial.println("LoRa Web Sender");

  // Create WiFi hotspot
  WiFi.softAP(ssid, password);

  Serial.print("IP Address: ");
  Serial.println(WiFi.softAPIP());

  // LoRa
  LoRa.setPins(SS, RST, DIO0);

  if (!LoRa.begin(433E6))
  {
    Serial.println("LoRa Error");

    while (1)
    {
      delay(1000);
    }
  }

  Serial.println("LoRa Started");

  // Web pages
  server.on("/", handleRoot);
  server.on("/on", handleON);
  server.on("/off", handleOFF);

  server.begin();

  Serial.println("Web Server Started");
}

void loop()
{
  server.handleClient();
}
