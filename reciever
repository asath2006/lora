#include <LoRa.h>

// Your existing LoRa wiring
#define SS   15    // D8
#define RST  16    // D0
#define DIO0 5     // D1

// NodeMCU onboard LED
#define LED_PIN 2  // D4 / GPIO2

void setup()
{
  Serial.begin(9600);

  Serial.println();
  Serial.println("LoRa Receiver");

  // Onboard LED
  pinMode(LED_PIN, OUTPUT);

  // NodeMCU onboard LED is active LOW
  // HIGH = OFF
  digitalWrite(LED_PIN, HIGH);

  // LoRa pins
  LoRa.setPins(SS, RST, DIO0);

  if (!LoRa.begin(433E6))
  {
    Serial.println("LoRa Error");

    while (1)
    {
      delay(1000);
    }
  }

  Serial.println("LoRa Receiver Started");
  Serial.println("Waiting for commands...");
}

void loop()
{
  int packetSize = LoRa.parsePacket();

  if (packetSize)
  {
    String data = "";

    while (LoRa.available())
    {
      data += (char)LoRa.read();
    }

    Serial.print("Received: ");
    Serial.println(data);

    // ONBOARD LED ON
    if (data == "LED_ON")
    {
      digitalWrite(LED_PIN, LOW);

      Serial.println("ONBOARD LED -> ON");
    }

    // ONBOARD LED OFF
    else if (data == "LED_OFF")
    {
      digitalWrite(LED_PIN, HIGH);

      Serial.println("ONBOARD LED -> OFF");
    }
  }
}
